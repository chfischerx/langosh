# LLM Provider Configuration
# Copy to .env and fill in your keys

# Default provider: anthropic, openai, deepseek, xai, bedrock_converse, claude_sdk
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (also used for DeepSeek, xAI)
OPENAI_API_KEY=

# AWS Bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_USE_IAM_ROLE=false

# General
MAX_TOKENS=4096
MAX_TOOL_TURNS=10
